<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RSVP_Event_App.ViewModels"
             x:Class="RSVP_Event_App.Views.RsvpPage"
             x:DataType="vm:RsvpViewModel"
             Title="RSVP">

    <ScrollView>
        <VerticalStackLayout Padding="30,20" Spacing="12" MaximumWidthRequest="460">

            <Label Text="{Binding EventName}" FontSize="24" FontAttributes="Bold" />
            <Label Text="{Binding EventDate}" TextColor="{StaticResource Gray400}" Margin="0,0,0,10" />

            <Label Text="Name" />
            <Entry Text="{Binding Name}" IsReadOnly="{Binding IsLoggedIn}" Placeholder="Your name" />

            <Label Text="E-Mail Address" />
            <Entry Text="{Binding Email}" IsReadOnly="{Binding IsLoggedIn}" Placeholder="you@example.com" Keyboard="Email" />

            <Label Text="Mobile Phone Number" />
            <Entry Text="{Binding Phone}" IsReadOnly="{Binding IsLoggedIn}" Placeholder="555-555-5555" Keyboard="Telephone" />

            <Label
                Text="{Binding ErrorMessage}"
                IsVisible="{Binding HasError}"
                TextColor="{StaticResource Error}"
                HorizontalTextAlignment="Center" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,10,0,0">
                <Button Text="Submit RSVP" Grid.Column="0" Command="{Binding SubmitCommand}" IsEnabled="{Binding IsNotBusy}" />
                <Button
                    Text="Cancel"
                    Grid.Column="1"
                    Command="{Binding CancelCommand}"
                    BackgroundColor="{StaticResource Gray500}"
                    TextColor="White" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
