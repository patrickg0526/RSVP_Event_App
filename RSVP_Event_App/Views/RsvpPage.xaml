<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RSVP_Event_App.Views.RsvpPage"
             Title="RSVP">

    <ScrollView>
        <VerticalStackLayout Padding="30,20" Spacing="12" MaximumWidthRequest="460">

            <Label x:Name="lblEventName" FontSize="24" FontAttributes="Bold" />
            <Label x:Name="lblEventDate" TextColor="{StaticResource Gray400}" Margin="0,0,0,10" />

            <Label Text="Name" />
            <Entry x:Name="txtName" Placeholder="Your name" />

            <Label Text="E-Mail Address" />
            <Entry x:Name="txtEmail" Placeholder="you@example.com" Keyboard="Email" />

            <Label Text="Mobile Phone Number" />
            <Entry x:Name="txtPhone" Placeholder="555-555-5555" Keyboard="Telephone" />

            <Label
                x:Name="lblError"
                TextColor="{StaticResource Error}"
                HorizontalTextAlignment="Center"
                IsVisible="False" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,10,0,0">
                <Button Text="Submit RSVP" Grid.Column="0" Clicked="OnSubmitClicked" />
                <Button
                    Text="Cancel"
                    Grid.Column="1"
                    Clicked="OnCancelClicked"
                    BackgroundColor="{StaticResource Gray500}"
                    TextColor="White" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
