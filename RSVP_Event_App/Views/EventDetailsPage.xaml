<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RSVP_Event_App.ViewModels"
             x:Class="RSVP_Event_App.Views.EventDetailsPage"
             x:DataType="vm:EventDetailsViewModel"
             Title="Event Details">

    <ScrollView>
        <VerticalStackLayout Padding="30,20" Spacing="14" MaximumWidthRequest="600">

            <Label Text="{Binding Event.Name}" FontSize="28" FontAttributes="Bold" />

            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="10">
                <Label Grid.Row="0" Grid.Column="0" Text="Hosted by" FontAttributes="Bold" />
                <Label Grid.Row="0" Grid.Column="1" Text="{Binding Event.HostName}" />
                <Label Grid.Row="1" Grid.Column="0" Text="Address" FontAttributes="Bold" />
                <Label Grid.Row="1" Grid.Column="1" Text="{Binding Event.Address}" />
                <Label Grid.Row="2" Grid.Column="0" Text="Date &amp; Time" FontAttributes="Bold" />
                <Label Grid.Row="2" Grid.Column="1" Text="{Binding Event.DateDisplay}" />
                <Label Grid.Row="3" Grid.Column="0" Text="RSVP Deadline" FontAttributes="Bold" />
                <Label Grid.Row="3" Grid.Column="1" Text="{Binding Event.DeadlineDisplay}" />
                <Label Grid.Row="4" Grid.Column="0" Text="Max Attendees" FontAttributes="Bold" />
                <Label Grid.Row="4" Grid.Column="1" Text="{Binding Event.MaxAttendees}" />
                <Label Grid.Row="5" Grid.Column="0" Text="Attending" FontAttributes="Bold" />
                <Label Grid.Row="5" Grid.Column="1" Text="{Binding Event.CurrentAttendees}" />
            </Grid>

            <Label Text="Who's Coming" FontSize="20" FontAttributes="Bold" Margin="0,10,0,0" />
            <Label Text="No one has RSVP'd yet." IsVisible="{Binding HasNoAttendees}" />
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Attendees}" Spacing="4">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Label Text="{Binding ., StringFormat='• {0}'}" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Label
                Text="{Binding StatusMessage}"
                IsVisible="{Binding HasStatus}"
                HorizontalOptions="Center"
                FontAttributes="Italic"
                Margin="0,10,0,0" />

            <Button
                Text="RSVP for this Event"
                Command="{Binding RsvpCommand}"
                IsEnabled="{Binding CanRsvp}" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
