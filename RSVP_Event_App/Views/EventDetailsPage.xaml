<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RSVP_Event_App.Views.EventDetailsPage"
             Title="Event Details">

    <ScrollView>
        <VerticalStackLayout Padding="30,20" Spacing="14" MaximumWidthRequest="600">

            <Label x:Name="lblName" FontSize="28" FontAttributes="Bold" />

            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="10">
                <Label Grid.Row="0" Grid.Column="0" Text="Hosted by" FontAttributes="Bold" />
                <Label Grid.Row="0" Grid.Column="1" x:Name="lblHost" />
                <Label Grid.Row="1" Grid.Column="0" Text="Address" FontAttributes="Bold" />
                <Label Grid.Row="1" Grid.Column="1" x:Name="lblAddress" />
                <Label Grid.Row="2" Grid.Column="0" Text="Date &amp; Time" FontAttributes="Bold" />
                <Label Grid.Row="2" Grid.Column="1" x:Name="lblDate" />
                <Label Grid.Row="3" Grid.Column="0" Text="RSVP Deadline" FontAttributes="Bold" />
                <Label Grid.Row="3" Grid.Column="1" x:Name="lblDeadline" />
                <Label Grid.Row="4" Grid.Column="0" Text="Max Attendees" FontAttributes="Bold" />
                <Label Grid.Row="4" Grid.Column="1" x:Name="lblMax" />
                <Label Grid.Row="5" Grid.Column="0" Text="Attending" FontAttributes="Bold" />
                <Label Grid.Row="5" Grid.Column="1" x:Name="lblCurrent" />
            </Grid>

            <Label Text="Who's Coming" FontSize="20" FontAttributes="Bold" Margin="0,10,0,0" />
            <VerticalStackLayout x:Name="stackAttendees" Spacing="4" />

            <Label
                x:Name="lblStatus"
                HorizontalOptions="Center"
                FontAttributes="Italic"
                Margin="0,10,0,0" />

            <Button
                x:Name="btnRsvp"
                Text="RSVP for this Event"
                Clicked="OnRsvpClicked" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
