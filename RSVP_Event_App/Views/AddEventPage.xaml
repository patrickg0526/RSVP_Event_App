<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RSVP_Event_App.ViewModels"
             x:Class="RSVP_Event_App.Views.AddEventPage"
             x:DataType="vm:AddEventViewModel"
             Title="Add Event">

    <ScrollView>
        <VerticalStackLayout Padding="30,20" Spacing="12" MaximumWidthRequest="500">

            <Label Text="Host Name" />
            <Entry Text="{Binding HostName}" Placeholder="Name of the person hosting" />

            <Label Text="Event Name" />
            <Entry Text="{Binding EventName}" Placeholder="Event name" />

            <Label Text="Event Address" />
            <Entry Text="{Binding Address}" Placeholder="Street, City, State" />

            <Label Text="Maximum Allowed Attendees" />
            <Entry Text="{Binding MaxAttendees}" Placeholder="e.g. 25" Keyboard="Numeric" />

            <Label Text="Event Date and Time" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <DatePicker Date="{Binding EventDate}" MinimumDate="{Binding MinimumDate}" Grid.Column="0" />
                <TimePicker Time="{Binding EventTime}" Grid.Column="1" />
            </Grid>

            <Label Text="RSVP Deadline" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <DatePicker Date="{Binding DeadlineDate}" MinimumDate="{Binding MinimumDate}" Grid.Column="0" />
                <TimePicker Time="{Binding DeadlineTime}" Grid.Column="1" />
            </Grid>

            <Label
                Text="{Binding ErrorMessage}"
                IsVisible="{Binding HasError}"
                TextColor="{StaticResource Error}"
                HorizontalTextAlignment="Center" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,10,0,0">
                <Button Text="Save" Grid.Column="0" Command="{Binding SaveCommand}" IsEnabled="{Binding IsNotBusy}" />
                <Button
                    Text="Cancel"
                    Grid.Column="1"
                    Command="{Binding CancelCommand}"
                    BackgroundColor="{StaticResource Gray500}"
                    TextColor="White" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
