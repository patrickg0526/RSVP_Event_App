<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RSVP_Event_App.ViewModels"
             x:Class="RSVP_Event_App.Views.CreateAccountPage"
             x:DataType="vm:CreateAccountViewModel"
             Title="Create Account">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,20"
            Spacing="12"
            MaximumWidthRequest="460">

            <Label Text="Name" />
            <Entry Text="{Binding Name}" Placeholder="Full name" />

            <Label Text="E-Mail Address" />
            <Entry Text="{Binding Email}" Placeholder="you@example.com" Keyboard="Email" />

            <Label Text="Password" />
            <Entry Text="{Binding Password}" Placeholder="Password" IsPassword="True" />

            <Label Text="Confirm Password" />
            <Entry Text="{Binding ConfirmPassword}" Placeholder="Re-enter password" IsPassword="True" />

            <Label Text="Mobile Phone Number" />
            <Entry Text="{Binding Phone}" Placeholder="555-555-5555" Keyboard="Telephone" />

            <Label
                Text="{Binding ErrorMessage}"
                IsVisible="{Binding HasError}"
                TextColor="{StaticResource Error}"
                HorizontalTextAlignment="Center" />

            <Grid ColumnSpacing="10" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    Text="Create Account"
                    Grid.Column="0"
                    Command="{Binding CreateCommand}"
                    IsEnabled="{Binding IsNotBusy}" />
                <Button
                    Text="Cancel"
                    Grid.Column="1"
                    Command="{Binding CancelCommand}"
                    BackgroundColor="{StaticResource Gray500}"
                    TextColor="White" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
