<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:RSVP_Event_App.Models"
             xmlns:vm="clr-namespace:RSVP_Event_App.ViewModels"
             xmlns:converters="clr-namespace:RSVP_Event_App.Converters"
             x:Class="RSVP_Event_App.Views.EventsPage"
             x:DataType="vm:EventsViewModel"
             Title="Events">

    <ContentPage.Resources>
        <converters:FilterColorConverter x:Key="FilterColor" />
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{Binding AccountText}" Command="{Binding AccountCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="20,10" RowSpacing="12">

        <Label
            Text="{Binding WelcomeText}"
            Grid.Row="0"
            FontSize="20"
            FontAttributes="Bold" />

        <!-- Filter bar: All / Attending / Hosting -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="8">
            <Button Grid.Column="0" Text="All"
                    Command="{Binding FilterCommand}" CommandParameter="{x:Static vm:EventFilter.All}"
                    BackgroundColor="{Binding IsAllSelected, Converter={StaticResource FilterColor}}" />
            <Button Grid.Column="1" Text="Attending" IsVisible="{Binding IsLoggedIn}"
                    Command="{Binding FilterCommand}" CommandParameter="{x:Static vm:EventFilter.Attending}"
                    BackgroundColor="{Binding IsAttendingSelected, Converter={StaticResource FilterColor}}" />
            <Button Grid.Column="2" Text="Hosting" IsVisible="{Binding IsLoggedIn}"
                    Command="{Binding FilterCommand}" CommandParameter="{x:Static vm:EventFilter.Hosting}"
                    BackgroundColor="{Binding IsHostingSelected, Converter={StaticResource FilterColor}}" />
        </Grid>

        <CollectionView
            Grid.Row="2"
            ItemsSource="{Binding Events}"
            SelectionMode="Single"
            SelectedItem="{Binding SelectedEvent}"
            SelectionChangedCommand="{Binding OpenEventCommand}">
            <CollectionView.EmptyView>
                <Label
                    Text="No events to display."
                    HorizontalOptions="Center"
                    Margin="0,40,0,0"
                    TextColor="{StaticResource Gray400}" />
            </CollectionView.EmptyView>
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Event">
                    <Border
                        Padding="16,12"
                        StrokeThickness="1"
                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#1E293B}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10">
                            <Label Grid.Row="0" Grid.Column="0" Text="{Binding Name}" FontSize="18" FontAttributes="Bold" />
                            <Label Grid.Row="1" Grid.Column="0" Text="{Binding DateDisplay}" FontSize="14" TextColor="{StaticResource Gray400}" />
                            <Label Grid.Row="2" Grid.Column="0" Text="{Binding HostName, StringFormat='Hosted by {0}'}" FontSize="14" TextColor="{StaticResource Gray400}" />
                            <Border
                                Grid.Row="0" Grid.RowSpan="3" Grid.Column="1"
                                VerticalOptions="Center"
                                Padding="10,4"
                                StrokeThickness="0"
                                BackgroundColor="{StaticResource Accent}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Label Text="{Binding AttendanceDisplay}" TextColor="White" FontSize="12" />
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button
            Grid.Row="3"
            Text="+ Add Event"
            Command="{Binding AddEventCommand}"
            IsVisible="{Binding IsLoggedIn}"
            BackgroundColor="{StaticResource Accent}"
            TextColor="White" />
    </Grid>

</ContentPage>
